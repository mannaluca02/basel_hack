{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "paxi",
  "observability": {"enabled": true},
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build --prefix ../.. && npm run build --prefix ../web -- --configuration live-production && node scripts/assets.mjs"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "LIFE",
        "class_name": "LifeInsuranceObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LifeInsuranceObject"
      ]
    }
  ],
  "alias": {
    "class-validator": "./src/optional-nest.cjs",
    "class-transformer": "./src/optional-nest.cjs",
    "@nestjs/microservices": "./src/optional-nest.cjs",
    "@nestjs/websockets/socket-module.js": "./src/optional-nest.cjs",
    "@nestjs/microservices/microservices-module.js": "./src/optional-nest.cjs"
  },
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "PAX_DEMO_START": "1",
    "PAX_SYNTHETIC_VOICE_ENABLED": "1",
    "PAX_SYNTHETIC_EXTRACTION_ENABLED": "1",
    "LIVE_MODEL": "gpt-live-1",
    "LIVE_VOICE": "juni",
    "PAX_PUBLIC_ORIGIN": ""
  }
}
