{
  "name": "@pax/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist",
    "check": "node scripts/check.mjs",
    "typecheck": "wrangler types .wrangler/worker-configuration.d.ts && tsc -p tsconfig.json",
    "setup:local": "node scripts/setup-local.mjs",
    "check:persistence": "node scripts/check-persistence.mjs",
    "deploy": "node scripts/deploy.mjs",
    "tail": "wrangler tail",
    "diagnose": "node scripts/diagnose.mjs"
  },
  "dependencies": {
    "@pax/api": "0.1.0",
    "@pax/contracts": "0.1.0"
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
