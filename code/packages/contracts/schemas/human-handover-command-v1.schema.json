{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "request",
        "resume"
      ]
    },
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "expectedCaseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "source": {
      "default": "ui",
      "type": "string",
      "enum": [
        "ui",
        "voice"
      ]
    }
  },
  "required": [
    "action",
    "messageId",
    "expectedCaseRevision",
    "source"
  ],
  "additionalProperties": false,
  "title": "human-handover-command-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
