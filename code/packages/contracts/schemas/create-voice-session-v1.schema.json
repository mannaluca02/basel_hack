{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "expectedCaseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provider": {
      "type": "string",
      "enum": [
        "gpt-live",
        "elevenlabs"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "de",
        "fr",
        "it",
        "en"
      ]
    },
    "dataClassification": {
      "type": "string",
      "const": "synthetic"
    },
    "noticeVersion": {
      "type": "string",
      "const": "voice-synthetic-v1"
    },
    "allowExternalVoiceProcessing": {
      "type": "boolean",
      "const": true
    },
    "sdp": {
      "type": "string",
      "minLength": 4,
      "maxLength": 100000
    },
    "resumeFrom": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "conversationSettings": {
      "type": "object",
      "properties": {
        "skillIds": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "timeBudgetMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 60
        },
        "priorities": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "full_name",
              "birth_date",
              "postal_code",
              "sex",
              "smoker",
              "civil_status",
              "relationship_since_year",
              "partner_birth_year",
              "partner_annual_gross_income_chf",
              "children_count",
              "children_birth_years",
              "expecting_child",
              "employment_type",
              "occupation",
              "employment_rate_percent",
              "annual_gross_income_chf",
              "first_working_year_switzerland",
              "has_pension_fund",
              "has_pillar_3a",
              "pillar_3a_annual_contribution_chf",
              "existing_life_insurance",
              "free_assets_chf",
              "housing",
              "monthly_housing_cost_chf",
              "debts_chf",
              "goals",
              "desired_retirement_age",
              "home_purchase_year",
              "risk_appetite",
              "net_income_band",
              "net_worth_band",
              "annual_saving_capacity_band",
              "one_time_investment_band",
              "investment_goal",
              "investment_horizon",
              "securities_experience",
              "reaction_to_30_percent_loss"
            ]
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "messageId",
    "expectedCaseRevision",
    "provider",
    "locale",
    "dataClassification",
    "noticeVersion",
    "allowExternalVoiceProcessing"
  ],
  "additionalProperties": false,
  "title": "create-voice-session-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
