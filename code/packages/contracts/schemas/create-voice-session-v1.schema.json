{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "expectedCaseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "provider": {
      "type": "string",
      "enum": [
        "gpt-live",
        "elevenlabs"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "de",
        "fr",
        "it",
        "en"
      ]
    },
    "dataClassification": {
      "type": "string",
      "const": "synthetic"
    },
    "noticeVersion": {
      "type": "string",
      "const": "voice-synthetic-v1"
    },
    "allowExternalVoiceProcessing": {
      "type": "boolean",
      "const": true
    },
    "sdp": {
      "type": "string",
      "minLength": 4,
      "maxLength": 100000
    },
    "resumeFrom": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    }
  },
  "required": [
    "messageId",
    "expectedCaseRevision",
    "provider",
    "locale",
    "dataClassification",
    "noticeVersion",
    "allowExternalVoiceProcessing"
  ],
  "additionalProperties": false,
  "title": "create-voice-session-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
