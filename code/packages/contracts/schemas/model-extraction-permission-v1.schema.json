{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "caseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "enabled": {
      "type": "boolean"
    },
    "noticeVersion": {
      "type": "string",
      "const": "extraction-synthetic-v1"
    },
    "noticeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "consent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "noticeVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "noticeHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "locale": {
              "type": "string",
              "enum": [
                "de",
                "fr",
                "it",
                "en"
              ]
            },
            "acceptedAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "noticeVersion",
            "noticeHash",
            "locale",
            "acceptedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "transferAllowed": {
      "type": "boolean"
    },
    "blockedReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "disabled",
            "consent_missing",
            "notice_changed",
            "human_handover_active"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "caseId",
    "caseRevision",
    "enabled",
    "noticeVersion",
    "noticeHash",
    "consent",
    "transferAllowed",
    "blockedReason"
  ],
  "additionalProperties": false,
  "title": "model-extraction-permission-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
