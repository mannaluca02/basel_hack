{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "provider": {
      "type": "string",
      "enum": [
        "gpt-live",
        "elevenlabs"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "de",
        "fr",
        "it",
        "en"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "starting",
        "active",
        "closed",
        "interrupted",
        "failed"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "endedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "closeReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "customer_closed",
            "voice_switch",
            "inactive",
            "human_handover",
            "session_revoked",
            "expired",
            "server_restart",
            "provider_failed",
            "shutdown"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "transcriptRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "turnCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resumeFrom": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "noticeVersion": {
      "type": "string",
      "const": "voice-synthetic-v1"
    },
    "dataClassification": {
      "type": "string",
      "const": "synthetic"
    },
    "externalVoiceProcessingAccepted": {
      "type": "boolean",
      "const": true
    },
    "remoteStop": {
      "type": "string",
      "enum": [
        "not_requested",
        "requested",
        "failed",
        "client_required"
      ]
    },
    "fullContextTransferAuthorized": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "caseId",
    "provider",
    "locale",
    "status",
    "createdAt",
    "expiresAt",
    "endedAt",
    "closeReason",
    "transcriptRevision",
    "turnCount",
    "resumeFrom",
    "noticeVersion",
    "dataClassification",
    "externalVoiceProcessingAccepted",
    "remoteStop",
    "fullContextTransferAuthorized"
  ],
  "additionalProperties": false,
  "title": "voice-session-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
