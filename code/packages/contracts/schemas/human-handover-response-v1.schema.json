{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "caseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "contextRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "handover": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "digital",
            "requested"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wantsHumanAdvisor": {
          "type": "boolean"
        },
        "leaveViewRequested": {
          "type": "boolean"
        },
        "stopDigitalConversation": {
          "type": "boolean"
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ui",
                "voice"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "revision",
        "wantsHumanAdvisor",
        "leaveViewRequested",
        "stopDigitalConversation",
        "requestId",
        "requestedAt",
        "resumedAt",
        "source"
      ],
      "additionalProperties": false
    },
    "contact": {
      "type": "object",
      "properties": {
        "organization": {
          "type": "string",
          "const": "Pax"
        },
        "kind": {
          "type": "string",
          "const": "public_general_contact"
        },
        "phone": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{7,14}$"
        },
        "displayPhone": {
          "type": "string",
          "maxLength": 40
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        },
        "verifiedAt": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "automaticDialing": {
          "type": "boolean",
          "const": false
        },
        "advisorAssigned": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "organization",
        "kind",
        "phone",
        "displayPhone",
        "sourceUrl",
        "verifiedAt",
        "automaticDialing",
        "advisorAssigned"
      ],
      "additionalProperties": false
    },
    "command": {
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "action": {
          "type": "string",
          "enum": [
            "request",
            "resume"
          ]
        },
        "replayed": {
          "type": "boolean"
        },
        "changed": {
          "type": "boolean"
        }
      },
      "required": [
        "messageId",
        "action",
        "replayed",
        "changed"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "caseId",
    "caseRevision",
    "contextRevision",
    "handover",
    "contact",
    "command"
  ],
  "additionalProperties": false,
  "title": "human-handover-response-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
