{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "speaker": {
      "type": "string",
      "enum": [
        "customer",
        "agent"
      ]
    },
    "log": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1.0"
        },
        "messageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "caseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "turnId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "source": {
          "type": "string",
          "enum": [
            "voice",
            "text"
          ]
        },
        "locale": {
          "type": "string",
          "enum": [
            "de",
            "fr",
            "it",
            "en"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "transcriptStatus": {
          "type": "string",
          "const": "final"
        },
        "dataClassification": {
          "type": "string",
          "const": "synthetic"
        },
        "expectedCaseRevision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schemaVersion",
        "messageId",
        "caseId",
        "correlationId",
        "turnId",
        "source",
        "locale",
        "text",
        "transcriptStatus",
        "dataClassification"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "speaker",
    "log"
  ],
  "additionalProperties": false,
  "title": "voice-turn-input-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
