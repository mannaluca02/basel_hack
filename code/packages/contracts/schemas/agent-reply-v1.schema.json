{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "turnId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "replyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "contextRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "kind": {
      "type": "string",
      "enum": [
        "question",
        "patch_proposal",
        "explanation",
        "summary_notice",
        "error"
      ]
    },
    "locale": {
      "type": "string",
      "enum": [
        "de",
        "fr",
        "it",
        "en"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "requiresConfirmation": {
      "type": "boolean"
    },
    "containsFinancialAmounts": {
      "type": "boolean"
    },
    "contextId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "profileVersion": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "scenarioVersionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "calculationInputHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "factRefs": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "metricId": {
            "type": "string",
            "maxLength": 160
          },
          "runId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "profileVersion": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "scenarioVersionId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "sourceRefs": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "metricId",
          "runId",
          "profileVersion",
          "scenarioVersionId",
          "sourceRefs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "messageId",
    "caseId",
    "correlationId",
    "turnId",
    "replyId",
    "contextRevision",
    "kind",
    "locale",
    "text",
    "requiresConfirmation",
    "containsFinancialAmounts",
    "contextId",
    "runId",
    "profileVersion",
    "scenarioVersionId",
    "calculationInputHash",
    "factRefs"
  ],
  "additionalProperties": false,
  "title": "agent-reply-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
