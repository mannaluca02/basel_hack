{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "expectedCaseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "expectedProfileVersion": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "basisDraftHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "transcriptRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "observations": {
      "minItems": 1,
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "enum": [
              "full_name",
              "birth_date",
              "postal_code",
              "sex",
              "smoker",
              "civil_status",
              "relationship_since_year",
              "partner_birth_year",
              "partner_annual_gross_income_chf",
              "children_count",
              "children_birth_years",
              "expecting_child",
              "employment_type",
              "occupation",
              "employment_rate_percent",
              "annual_gross_income_chf",
              "first_working_year_switzerland",
              "has_pension_fund",
              "has_pillar_3a",
              "pillar_3a_annual_contribution_chf",
              "existing_life_insurance",
              "free_assets_chf",
              "housing",
              "monthly_housing_cost_chf",
              "debts_chf",
              "goals",
              "desired_retirement_age",
              "home_purchase_year",
              "risk_appetite",
              "net_income_band",
              "net_worth_band",
              "annual_saving_capacity_band",
              "one_time_investment_band",
              "investment_goal",
              "investment_horizon",
              "securities_experience",
              "reaction_to_30_percent_loss"
            ]
          },
          "personId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "sourceMessageId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "value": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "precision": {
            "type": "string",
            "enum": [
              "exact",
              "approximate",
              "range",
              "unknown"
            ]
          },
          "unit": {
            "type": "string",
            "enum": [
              "CHF",
              "percent",
              "year",
              "boolean",
              "enum",
              "text"
            ]
          },
          "period": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "month",
                  "year",
                  "once"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "basis": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "gross",
                  "net_after_income_tax",
                  "net_before_income_tax",
                  "not_applicable"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "fieldId",
          "sourceMessageId",
          "quote",
          "value",
          "precision",
          "unit",
          "period",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "supersedesBatchIds": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      }
    },
    "supersedesProposalIds": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      }
    },
    "resolvesAmbiguityIds": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,80}$"
      }
    }
  },
  "required": [
    "messageId",
    "expectedCaseRevision",
    "expectedProfileVersion",
    "basisDraftHash",
    "transcriptRevision",
    "observations",
    "supersedesBatchIds",
    "supersedesProposalIds",
    "resolvesAmbiguityIds"
  ],
  "additionalProperties": false,
  "title": "voice-extraction-input-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
