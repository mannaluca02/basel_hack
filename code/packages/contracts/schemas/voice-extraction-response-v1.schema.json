{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "voiceSessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "caseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "contextRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "mappingVersion": {
      "type": "string",
      "const": "voice-portfolio-v1"
    },
    "proposalBatch": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "messageId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            "source": {
              "type": "object",
              "properties": {
                "messageId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "turnId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                "sourceRef": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              },
              "required": [
                "messageId",
                "turnId",
                "sourceRef"
              ],
              "additionalProperties": false
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "requestHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "expectedProfileVersion": {
              "anyOf": [
                {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "basisDraftHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "changes": {
              "maxItems": 50,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "value": {
                    "$ref": "#/$defs/__schema0"
                  },
                  "personId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,80}$"
                  }
                },
                "required": [
                  "path",
                  "value"
                ],
                "additionalProperties": false
              }
            },
            "status": {
              "type": "string",
              "enum": [
                "proposed",
                "accepted",
                "superseded",
                "rejected"
              ]
            },
            "supersedesBatchIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "supersedesProposalIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "replacedByBatchId": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,80}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "ambiguityIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "resolvesAmbiguityIds": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,80}$"
              }
            },
            "acceptedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "messageId",
            "source",
            "createdAt",
            "requestHash",
            "expectedProfileVersion",
            "basisDraftHash",
            "changes",
            "status",
            "supersedesBatchIds",
            "supersedesProposalIds",
            "replacedByBatchId",
            "ambiguityIds",
            "resolvesAmbiguityIds",
            "acceptedAt"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fieldId": {
            "type": "string",
            "enum": [
              "full_name",
              "birth_date",
              "postal_code",
              "sex",
              "smoker",
              "civil_status",
              "relationship_since_year",
              "partner_birth_year",
              "partner_annual_gross_income_chf",
              "children_count",
              "children_birth_years",
              "expecting_child",
              "employment_type",
              "occupation",
              "employment_rate_percent",
              "annual_gross_income_chf",
              "first_working_year_switzerland",
              "has_pension_fund",
              "has_pillar_3a",
              "pillar_3a_annual_contribution_chf",
              "existing_life_insurance",
              "free_assets_chf",
              "housing",
              "monthly_housing_cost_chf",
              "debts_chf",
              "goals",
              "desired_retirement_age",
              "home_purchase_year",
              "risk_appetite",
              "net_income_band",
              "net_worth_band",
              "annual_saving_capacity_band",
              "one_time_investment_band",
              "investment_goal",
              "investment_horizon",
              "securities_experience",
              "reaction_to_30_percent_loss"
            ]
          },
          "code": {
            "type": "string",
            "enum": [
              "NOT_COLLECTED_FOR_DEMO",
              "HUMAN_REVIEW_REQUIRED",
              "LOOKUP_REQUIRED",
              "STRUCTURED_INPUT_REQUIRED",
              "TARGET_MISSING",
              "AMBIGUOUS_VALUE"
            ]
          },
          "requiresFollowUp": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "fieldId",
          "code",
          "requiresFollowUp"
        ],
        "additionalProperties": false
      }
    },
    "confirmationStillRequired": {
      "type": "boolean",
      "const": true
    },
    "replayed": {
      "type": "boolean"
    }
  },
  "required": [
    "caseId",
    "voiceSessionId",
    "caseRevision",
    "contextRevision",
    "mappingVersion",
    "proposalBatch",
    "issues",
    "confirmationStillRequired",
    "replayed"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "title": "voice-extraction-response-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
