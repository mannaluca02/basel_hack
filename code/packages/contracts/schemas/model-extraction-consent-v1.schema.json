{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "expectedCaseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "noticeVersion": {
      "type": "string",
      "const": "extraction-synthetic-v1"
    },
    "noticeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dataClassification": {
      "type": "string",
      "const": "synthetic"
    },
    "allowSyntheticModelExtraction": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "expectedCaseRevision",
    "noticeVersion",
    "noticeHash",
    "dataClassification",
    "allowSyntheticModelExtraction"
  ],
  "additionalProperties": false,
  "title": "model-extraction-consent-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
