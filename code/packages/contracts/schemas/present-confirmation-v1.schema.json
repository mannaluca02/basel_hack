{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "questionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "questionHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "questionTurnId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "questionReplyId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "expectedCaseRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reviewDisplayed": {
      "type": "boolean",
      "const": true
    },
    "profileAndAssumptionsDisplayed": {
      "type": "boolean"
    },
    "privacyNoticeDisplayed": {
      "type": "boolean"
    },
    "playback": {
      "type": "object",
      "properties": {
        "playbackId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,80}$"
        },
        "event": {
          "type": "string",
          "const": "ended"
        }
      },
      "required": [
        "playbackId",
        "event"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "questionId",
    "questionHash",
    "questionTurnId",
    "questionReplyId",
    "expectedCaseRevision",
    "reviewDisplayed",
    "profileAndAssumptionsDisplayed",
    "privacyNoticeDisplayed"
  ],
  "additionalProperties": false,
  "title": "present-confirmation-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
