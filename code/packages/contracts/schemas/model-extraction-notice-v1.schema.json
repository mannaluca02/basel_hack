{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "extraction-synthetic-v1"
    },
    "noticeHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "enabled": {
      "type": "boolean"
    },
    "provider": {
      "type": "string",
      "const": "openai"
    },
    "api": {
      "type": "string",
      "const": "responses"
    },
    "purpose": {
      "type": "string",
      "const": "intake_field_extraction"
    },
    "syntheticOnly": {
      "type": "boolean",
      "const": true
    },
    "separateConsentRequired": {
      "type": "boolean",
      "const": true
    },
    "payloadScope": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "invented_conversation_excerpt",
          "pseudonymous_person_id",
          "relevant_field_values_with_unit_and_income_basis",
          "allowed_target_paths",
          "related_clarifications"
        ]
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "full_case_context",
          "revisions_hashes_and_permissions",
          "credentials_and_tokens",
          "raw_audio",
          "health_data",
          "real_customer_data"
        ]
      }
    },
    "fullCaseTransferAuthorized": {
      "type": "boolean",
      "const": false
    },
    "resultIsProposalOnly": {
      "type": "boolean",
      "const": true
    },
    "calculatorTransferIsSeparate": {
      "type": "boolean",
      "const": true
    },
    "locale": {
      "type": "string",
      "enum": [
        "de",
        "fr",
        "it",
        "en"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  },
  "required": [
    "version",
    "noticeHash",
    "enabled",
    "provider",
    "api",
    "purpose",
    "syntheticOnly",
    "separateConsentRequired",
    "payloadScope",
    "excluded",
    "fullCaseTransferAuthorized",
    "resultIsProposalOnly",
    "calculatorTransferIsSeparate",
    "locale",
    "text"
  ],
  "additionalProperties": false,
  "title": "model-extraction-notice-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
