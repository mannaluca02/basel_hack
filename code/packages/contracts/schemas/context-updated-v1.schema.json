{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "contextRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "maxLength": 100
    },
    "contextRef": {
      "type": "string",
      "pattern": "^\\/api\\/cases\\/[A-Za-z0-9_-]+\\/advisor\\/context$"
    },
    "interruptPolicy": {
      "type": "string",
      "enum": [
        "refresh_before_next_turn",
        "if_current_answer_invalid"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "messageId",
    "caseId",
    "correlationId",
    "eventId",
    "contextRevision",
    "reason",
    "contextRef",
    "interruptPolicy"
  ],
  "additionalProperties": false,
  "title": "context-updated-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
