{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "messageId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "correlationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "contextRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "reason": {
      "type": "string",
      "maxLength": 100
    },
    "voiceSessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "contextRef": {
      "type": "string",
      "pattern": "^\\/api\\/cases\\/[A-Za-z0-9_-]+\\/advisor\\/context$"
    },
    "handover": {
      "default": {
        "status": "digital",
        "revision": 0,
        "wantsHumanAdvisor": false,
        "leaveViewRequested": false,
        "stopDigitalConversation": false,
        "requestId": null,
        "requestedAt": null,
        "resumedAt": null,
        "source": null
      },
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "digital",
            "requested"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "wantsHumanAdvisor": {
          "type": "boolean"
        },
        "leaveViewRequested": {
          "type": "boolean"
        },
        "stopDigitalConversation": {
          "type": "boolean"
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,80}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "requestedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "ui",
                "voice"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "status",
        "revision",
        "wantsHumanAdvisor",
        "leaveViewRequested",
        "stopDigitalConversation",
        "requestId",
        "requestedAt",
        "resumedAt",
        "source"
      ],
      "additionalProperties": false
    },
    "interruptPolicy": {
      "type": "string",
      "enum": [
        "refresh_before_next_turn",
        "if_current_answer_invalid",
        "immediate"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "messageId",
    "caseId",
    "correlationId",
    "eventId",
    "contextRevision",
    "reason",
    "contextRef",
    "handover",
    "interruptPolicy"
  ],
  "additionalProperties": false,
  "title": "context-updated-v1",
  "description": "Pax synthetic-data PoC contract v1. Runtime Zod/domain reference checks and authorization remain authoritative; JSON Schema alone does not grant permission."
}
