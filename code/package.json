{
  "name": "pax-lifemap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "apps/api"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && npm run typecheck:clients && npm run contracts:check && node --test tests/*.test.mjs",
    "typecheck:clients": "tsc -p examples/contracts/tsconfig.json",
    "contracts:export": "npm run build && node scripts/export-contracts.mjs",
    "contracts:check": "node scripts/export-contracts.mjs --check",
    "contracts:examples": "npm run build && node scripts/export-demo-contracts.mjs",
    "start": "npm run build && node --env-file-if-exists=../documentation/baselhack/private/logismata.env apps/api/dist/main.js",
    "start:demo": "npm run build && node scripts/start-demo.mjs",
    "demo": "npm run build && node scripts/demo.mjs",
    "test:live": "npm run build && node --env-file-if-exists=../documentation/baselhack/private/logismata.env scripts/live-journey.mjs",
    "test:live:metadata": "npm run build && node --env-file-if-exists=../documentation/baselhack/private/logismata.env scripts/live-smoke.mjs",
    "demo:extraction": "npm run build && node scripts/demo-extraction.mjs",
    "contracts:extraction-examples": "npm run build && node scripts/demo-extraction.mjs --export",
    "demo:voice-confirmation": "npm run build && node scripts/demo-voice-confirmation.mjs",
    "contracts:voice-examples": "npm run build && node scripts/demo-voice-confirmation.mjs --export",
    "demo:handover": "npm run build && node scripts/demo-human-handover.mjs",
    "demo:customer-review": "npm run build && node scripts/demo-customer-review.mjs",
    "contracts:handover-examples": "npm run build && node scripts/demo-human-handover.mjs --export"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
