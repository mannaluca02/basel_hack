{
  "name": "pax-lifemap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "packageManager": "npm@10.9.8",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && npm run typecheck:clients && npm run contracts:check && node --test tests/*.test.mjs",
    "test:coverage": "npm run build && node --test --experimental-test-coverage --test-coverage-include='apps/api/dist/**' --test-coverage-include='packages/*/dist/**' tests/*.test.mjs",
    "test:all": "npm test && npm --prefix voice-agent test && npm --prefix apps/web test -- --watch=false",
    "typecheck:clients": "tsc -p examples/contracts/tsconfig.json",
    "contracts:export": "npm run build && node scripts/export-contracts.mjs",
    "contracts:check": "node scripts/export-contracts.mjs --check",
    "contracts:examples": "npm run build && node scripts/export-demo-contracts.mjs",
    "start": "npm run build && node --env-file-if-exists=../.env apps/api/dist/main.js",
    "dev:demo": "node scripts/dev-demo.mjs",
    "dev:debug": "node scripts/dev-demo.mjs --debug",
    "dev:paxi": "node scripts/dev-demo.mjs --paxi",
    "dev:live": "node scripts/dev-demo.mjs --live",
    "start:voice-lab": "npm run build && node --env-file-if-exists=../.env scripts/start-voice-lab.mjs",
    "test:live": "npm run build && node --env-file-if-exists=../.env scripts/live-journey.mjs",
    "test:live:metadata": "npm run build && node --env-file-if-exists=../.env scripts/live-smoke.mjs",
    "test:live:conversation": "npm run build && node --env-file-if-exists=../.env scripts/live-conversation.mjs",
    "test:voice": "npm run build && node --test tests/voice-integration.test.mjs tests/customer-confirmations.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "5.9.3"
  }
}
