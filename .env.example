# Template for the only local configuration file: copy to `.env` in the repo root and fill in.
# Never commit `.env` (gitignored). Read on the server side only by the case backend
# (`npm --prefix code start`, `dev:demo`, `test:live`), the voice agent and the avatar prototype.
# Never put any of these values into the Angular app.

# Logismata APICalc, the calculator of the backend. Token: challenge hub https://pax-hackathon-2026.vercel.app (Tools tab).
LOGISMATA_BASE_URL=https://baselhackathon2026.azurewebsites.net/viper
LOGISMATA_BEARER_TOKEN=<bearer-token-from-hub-tools-page>

# Password for the challenge hub (optional, only for reading the hub)
# PAX_HUB_PASSWORD=<hub-password>

# OpenAI key: Paxi's voice (code/voice-agent), the avatar prototype and the extractions.
OPENAI_API_KEY=

# Backend voice integration, synthetic data only; explicit consent per session. Also needed so Paxi
# can propose what it heard to the shared case (POST /api/cases/:id/voice/agent-observations).
PAX_SYNTHETIC_VOICE_ENABLED=0
LIVE_MODEL=gpt-live-1
LIVE_VOICE=juni
# LIVE_BACKEND_MODEL=gpt-6-luna
# Italian Paxi voice (`node code/voice-agent/create-voice.mjs italian`), used after switching to Italian
# LIVE_VOICE_ID_IT=voice_...

# ElevenLabs as an alternative voice provider of the backend; use an existing, team-configured agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Earnie's synthetic OpenAI intake extraction: off by default. Even when on, the customer must accept
# the current notice per case (POST /api/cases/:caseId/extraction/consent); it reuses OPENAI_API_KEY.
PAX_SYNTHETIC_EXTRACTION_ENABLED=0

# Paxi voice agent: where the case backend runs and which app may hand it a case
# PAX_API_URL=http://127.0.0.1:3000
# PAX_APP_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
