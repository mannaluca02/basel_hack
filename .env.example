# Copy to .env and fill in. Never commit .env.
# Values: challenge hub https://pax-hackathon-2026.vercel.app (Tools tab), ask the team for the hub password.

# Logismata APICalc (see documentation/logismata-api.md)
LOGISMATA_BASE_URL=https://baselhackathon2026.azurewebsites.net/viper
LOGISMATA_TOKEN=<bearer-token-from-hub-tools-page>
# The Nest backend (npm --prefix code start) reads the same token as LOGISMATA_BEARER_TOKEN.
LOGISMATA_BEARER_TOKEN=<bearer-token-from-hub-tools-page>

# Password for the challenge hub
PAX_HUB_PASSWORD=<hub-password>

# Nest voice integration: disabled by default; explicit synthetic-data consent is required per session.
# npm --prefix code start reads root .env on the server only. Never expose these keys in Angular.
PAX_SYNTHETIC_VOICE_ENABLED=0
OPENAI_API_KEY=
LIVE_MODEL=gpt-live-1
LIVE_VOICE=juni
ELEVENLABS_API_KEY=
# Use an existing, team-configured agent; Nest does not create/update agents.
ELEVENLABS_AGENT_ID=

# Earnie's synthetic OpenAI intake extraction: disabled by default. Even when enabled, the customer must accept
# the current notice per case (POST /api/cases/:caseId/extraction/consent); the extractor reuses OPENAI_API_KEY server-side.
PAX_SYNTHETIC_EXTRACTION_ENABLED=0
