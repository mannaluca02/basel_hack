# Copy to .env and fill in. Never commit .env.
# Values: challenge hub https://pax-hackathon-2026.vercel.app (Tools tab), ask the team for the hub password.

# Logismata APICalc (see documentation/logismata-api.md)
LOGISMATA_BASE_URL=https://baselhackathon2026.azurewebsites.net/viper
LOGISMATA_TOKEN=<bearer-token-from-hub-tools-page>

# Password for the challenge hub
PAX_HUB_PASSWORD=<hub-password>
