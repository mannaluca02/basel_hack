# Copy to .env and fill in. Never commit .env.
# Values: challenge hub https://pax-hackathon-2026.vercel.app (Tools tab), ask the team for the hub password.

# Logismata APICalc (see documentation/logismata-api.md)
LOGISMATA_BASE_URL=https://baselhackathon2026.azurewebsites.net/viper
LOGISMATA_TOKEN=<bearer-token-from-hub-tools-page>

# Password for the challenge hub
PAX_HUB_PASSWORD=<hub-password>

# OpenAI project key with GPT-Live-1 access (paid tier), used by code/voice-agent
# and the avatar prototype (code/avatar-prototype/server.mjs)
OPENAI_API_KEY=<openai-api-key>
# Optional overrides for the voice agent
# LIVE_MODEL=gpt-live-1
# LIVE_BACKEND_MODEL=gpt-6-luna
# Voice for the welcome and German: juni, nuri or flitz
# LIVE_VOICE=juni
# Italian Paxi voice (`node code/voice-agent/create-voice.mjs italian`), used after switching to Italian
# LIVE_VOICE_ID_IT=voice_...
